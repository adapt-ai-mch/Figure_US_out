# Python environment (rebuild with: python3 -m venv .venv && pip install -r requirements.txt)
.venv/
__pycache__/
*.pyc

# Evaluation outputs: produced from real study data, never committed
eval_output/
synthetic_data/

# Local Claude Code settings and installed third-party skills
.claude/
.agents/
skills-lock.json

# GUI dependencies (reinstall with: npm --prefix gui install). gui/dist/ is committed on purpose:
# the built GUI lets a computer run FigureUS(out) with Python alone, without Node.
node_modules/

# macOS
.DS_Store
